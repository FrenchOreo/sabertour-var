{
  "name": "saber-var",
  "version": "1.1.0",
  "description": "Système VAR pour Saber Tour — Vidéo arbitrage sabre laser",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build:client": "cd client && npm install && npm run build",
    "build:app": "npm run build:client && electron-builder",
    "build:app:mac": "npm run build:client && electron-builder --mac",
    "build:app:win": "npm run build:client && electron-builder --win"
  },
  "build": {
    "appId": "com.sabertour.var",
    "productName": "SABER VAR",
    "publish": {
      "provider": "github",
      "owner": "FrenchOreo",
      "repo": "sabertour-var"
    },
    "files": [
      "electron/**/*",
      "client/dist/**/*",
      "shared/**/*",
      "scripts/afterPack.js"
    ],
    "directories": {
      "output": "release"
    },
    "afterPack": "scripts/afterPack.js",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        }
      ],
      "artifactName": "SABER-VAR-${version}-mac-${arch}.${ext}",
      "category": "public.app-category.sports",
      "icon": null
    },
    "win": {
      "target": "nsis",
      "artifactName": "SABER-VAR-${version}-windows-setup.${ext}",
      "icon": null
    },
    "linux": {
      "target": "AppImage"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "express": "^5.2.1",
    "selfsigned": "^2.4.1",
    "ws": "^8.20.0"
  }
}
